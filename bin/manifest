#!/usr/bin/env python3
"""manifest — the single source of truth for what we publish, and where.

Output is DETERMINISTIC: no timestamps. A generated file carrying the current
date changes every day, so a staleness check can never pass on a later day and
the gate gets disabled. Provenance comes from git log.

Scans authored markdown, reads its front matter, and generates:

  project/PUBLISHING.md   human-readable manifest: every document, status,
                          version, and its public URL
  docs/manifest.json      machine-readable, published with the site
  mkdocs.nav.yml          the site navigation, GENERATED

Nav is generated because a hand-maintained one silently rots: after the
spec/project rename, docs/index.md still linked to architecture/PLAN-*.md and
Pages went red on main. A document is published because it exists and declares
a status — not because someone remembered to add a line.

Run: bin/manifest   (bin/build-site calls it)
"""
import json, pathlib, re, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SITE = "https://m-of-n.github.io/mofn"
REPO = "https://github.com/m-of-n/mofn/blob/main"

# authored tree -> (site section, nav title, staged subdir)
TREES = [
    ("spec",     "Architecture", "architecture"),
    ("project",  "Planning",     "project"),
    ("research", "Research",     "research"),
]


def front(p):
    t = p.read_text()
    if not t.startswith("---"):
        return {}
    end = t.find("\n---", 3)
    if end < 0:
        return {}
    fm, out = t[3:end], {}
    for line in fm.splitlines():
        m = re.match(r'^([a-z_]+):\s*"?([^"\n]*)"?\s*$', line)
        if m and m.group(2):
            out[m.group(1)] = m.group(2).strip()
    return out


def main():
    docs, nav = [], []
    for tree, section, staged in TREES:
        d = ROOT / tree
        if not d.is_dir():
            continue
        entries = []
        for p in sorted(d.glob("*.md")):
            if p.read_text(errors="ignore").lstrip().startswith("<!-- GENERATED"):
                continue          # never list a generated view as a document
            fm = front(p)
            if fm.get("publish") == "false":
                continue
            docs.append({
                "id": fm.get("id", p.stem),
                "title": fm.get("title", p.stem),
                "type": fm.get("type", ""),
                "status": fm.get("status", "unknown"),
                "version": fm.get("version", ""),
                "updated": fm.get("updated", ""),
                "source": f"{tree}/{p.name}",
                "url": f"{SITE}/{staged}/{p.name[:-3]}/",
                "reviewed": fm.get("reviewed", ""),
            })
            entries.append((fm.get("title", p.stem), f"{staged}/{p.name}"))
        if entries:
            nav.append((section, entries))

    # ---- generated nav
    lines = ["# GENERATED by bin/manifest — do not edit. Edit front matter instead.",
             "nav:", "  - Home: index.md", "  - Limitations: LIMITATIONS.md"]
    for section, entries in nav:
        lines.append(f"  - {section}:")
        for title, path in entries:
            safe = title.replace('"', "'")
            lines.append(f'      - "{safe}": {path}')
    # Only list library pages the PINNED submodule actually provides — a pin
    # predating a generator must not put a dead entry in the nav.
    lib = []
    if (ROOT / "library" / "docs" / "construction.md").exists():
        lib.append(("Construction method", "library/construction.md"))
    # Test the GENERATOR, not its output. index/bibliography.md is generated and
    # gitignored since library#31, so on a clean checkout it does not exist
    # until bin/build-site runs bin/reindex — and bin/manifest used to run
    # first. This generator's output then depended on whether somebody happened
    # to have run reindex locally: on CI and any fresh clone the nav lost the
    # bibliography, while the tracked mkdocs.nav.yml still listed it and hid
    # that. If the pinned library can generate the page, build-site does, and
    # hard-fails if it cannot — so the generator is the honest test. The second
    # clause keeps a pre-library#31 pin, which tracked the file and has no
    # bin/reindex, working.
    if ((ROOT / "library" / "bin" / "reindex").exists()
            or (ROOT / "library" / "index" / "bibliography.md").exists()):
        lib.append(("Bibliography", "library/bibliography.md"))
    else:
        print("manifest: pinned library provides no bibliography — nav omits it",
              file=sys.stderr)
    if lib:
        lines.append("  - Library:")
        for title, path in lib:
            lines.append(f"      - {title}: {path}")
    lines.append("  - Download: download.md")
    (ROOT / "mkdocs.nav.yml").write_text("\n".join(lines) + "\n")

    # ---- machine manifest
    (ROOT / "docs").mkdir(exist_ok=True)
    (ROOT / "docs" / "manifest.json").write_text(json.dumps(
        {"site": SITE, "count": len(docs), "documents": docs}, indent=2) + "\n")

    # ---- human manifest
    out = ["<!-- GENERATED by bin/manifest — do not edit. -->", "",
           "# Publishing manifest", "",
           f"{len(docs)} documents published to [{SITE}]({SITE}/).", "",
           "A document is published because it **exists and declares a status** in its",
           "front matter — not because someone remembered to add it to a nav list. Set",
           "`publish: false` to withhold one.", ""]
    for tree, section, _ in TREES:
        rows = [d for d in docs if d["source"].startswith(tree + "/")]
        if not rows:
            continue
        out += [f"## {section}", "", "| document | id | status | version | updated | |", "|---|---|---|---|---|---|"]
        for d in rows:
            flag = " ⚠️" if d["status"] in ("draft", "proposed") else ""
            # Absolute URLs deliberately: this file is staged into docs/project/,
            # so a repo-relative link resolves against the wrong directory and
            # fails mkdocs --strict.
            out.append(f"| [{d['title']}]({d['url']}) | `{d['id']}` | {d['status']}{flag} "
                       f"| {d['version']} | {d['updated']} | [source]({REPO}/{d['source']}) |")
        out.append("")
    drafts = [d for d in docs if d["status"] in ("draft", "proposed")]
    out += ["## Status", "",
            f"⚠️ **{len(drafts)} of {len(docs)} published documents are draft or proposed.**",
            "They are public and marked as such. Nothing here is accepted; an open",
            "`DEC-*` is not settled because it appears on a website.", ""]
    (ROOT / "project" / "PUBLISHING.md").write_text("\n".join(out) + "\n")

    print(f"manifest: {len(docs)} documents ({len(drafts)} draft/proposed) "
          f"→ project/PUBLISHING.md, docs/manifest.json, mkdocs.nav.yml")
    return 0


if __name__ == "__main__":
    sys.exit(main())
