#!/usr/bin/env python3
"""validate-archdoc — enforce the archdoc/v1 contract on artifacts/docs/.

Enforces ARCH-0001 §9.5 mechanically: version and updated must change together.
Process rules that are not enforced are not followed by week six.
"""
import pathlib, re, subprocess, sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DOCS = [ROOT / "spec", ROOT / "project"]
REQ = ["schema", "id", "title", "type", "status", "version", "date", "updated"]
KINDS = {"ARCH", "ADR", "MAP", "PLAN", "PROC", "BACKLOG", "DECISIONS", "GLOSSARY", "RETRO", "APP"}
errs = []

try:
    COMMIT_DATE = subprocess.run(["git", "log", "-1", "--format=%cs"], capture_output=True,
                                 text=True, cwd=ROOT).stdout.strip()
except Exception:
    COMMIT_DATE = ""
STALE_DAYS = 7
if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", COMMIT_DATE or ""):
    import datetime
    COMMIT_DATE = datetime.date.today().isoformat()


def front(p):
    t = p.read_text()
    if not t.startswith("---"):
        return None, t
    end = t.find("\n---", 3)
    if end < 0:
        return None, t
    return t[3:end], t


def changed_in_head(path):
    try:
        out = subprocess.run(["git", "diff", "HEAD~1", "--unified=0", "--", str(path)],
                             capture_output=True, text=True, cwd=ROOT)
        return out.stdout
    except Exception:
        return ""


for p in sorted(q for d in DOCS for q in d.glob("*.md")):
    fm, raw = front(p)
    rel = p.relative_to(ROOT)
    if raw.lstrip().startswith("<!-- GENERATED"):
        continue          # generated views carry no front matter by design
    if fm is None:
        errs.append(f"{rel}: no archdoc/v1 front matter")
        continue
    for k in REQ:
        if not re.search(rf"^{k}:", fm, re.M):
            errs.append(f"{rel}: missing front-matter key '{k}'")
    m = re.search(r"^id:\s*(\S+)", fm, re.M)
    if m:
        kind = m.group(1).split("-")[0]
        if kind not in KINDS:
            errs.append(f"{rel}: id '{m.group(1)}' must start with one of {sorted(KINDS)}")
    if re.search(r"^status:\s*(accepted|active)", fm, re.M) and re.search(r"^needs_review:\s*true", fm, re.M):
        errs.append(f"{rel}: status is accepted/active but needs_review is still true")
    # ARCH-0001 §9.5 — version and updated move together.
    # Checked by VALUE, not by textual diff: two bumps on the same day leave
    # 'updated' unchanged in the diff while still being correct.
    d = changed_in_head(p)
    if d:
        vc = bool(re.search(r"^\+version:", d, re.M))
        uc = bool(re.search(r"^\+updated:", d, re.M))
        if vc:
            m = re.search(r"^updated:\s*\"?([0-9]{4}-[0-9]{2}-[0-9]{2})", fm, re.M)
            if not m:
                errs.append(f"{rel}: §9.5 — 'version' changed but 'updated' is missing or not a date")
            else:
                # Tolerance, deliberately: a PR authored one day and merged the
                # next, a rebase, or a UTC midnight rollover must not fail a
                # rule whose point is catching a STALE 'updated'.
                import datetime as _dt
                try:
                    delta = (_dt.date.fromisoformat(COMMIT_DATE)
                             - _dt.date.fromisoformat(m.group(1))).days
                except ValueError:
                    delta = None
                if delta is None:
                    errs.append(f"{rel}: §9.5 — 'updated' is not a valid ISO date")
                elif delta > STALE_DAYS:
                    errs.append(f"{rel}: §9.5 — 'version' changed but 'updated' is {m.group(1)}, "
                                f"{delta} days before the commit date {COMMIT_DATE}. "
                                f"Bump 'updated' with 'version'.")
        elif uc:
            errs.append(f"{rel}: §9.5 — 'updated' changed without a 'version' bump")

for e in errs:
    print(f"ERROR {e}")
n = sum(len(list(d.glob("*.md"))) for d in DOCS)
print(f"\n{n} documents — {len(errs)} errors")
sys.exit(1 if errs else 0)
