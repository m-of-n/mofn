#!/usr/bin/env python3
"""build-references — render a survey's References section from library records.

Scans a markdown report for [@record-id] citations, resolves each against
library/records/*/<id>/record.yaml, and rewrites the block between
REFERENCES:BEGIN and REFERENCES:END.

Exits non-zero if any citation has no library record. That is the point:
the rule is that every reference in a survey resolves to a record we hold,
so an unresolvable citation must fail the build rather than print a gap.
"""
import re, sys, os, pathlib, argparse

ROOT = pathlib.Path(__file__).resolve().parent.parent

def scalar(text, key):
    m = re.search(r'^%s:\s*(.+?)\s*$' % re.escape(key), text, re.M)
    if not m: return ""
    v = m.group(1).strip()
    if v and v[0] in "\"'" and v[-1] == v[0]: v = v[1:-1]
    return v

def load():
    recs = {}
    for p in LIB.glob("*/*/record.yaml"):
        t = p.read_text()
        rid = p.parent.name
        recs[rid] = {
            "id": rid,
            "title": scalar(t, "  title") or scalar(t, "title"),
            "url": scalar(t, "  url") or scalar(t, "url"),
            "body": p.parent.parent.name,
            "type": scalar(t, "type"),
        }
    return recs

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("report", nargs="?",
                    default=str(ROOT/"research/0001-signatures-and-attestation/report.md"))
    ap.add_argument("--library", default=os.environ.get("MOFN_LIBRARY"),
                    help="path to the library repo. Defaults to the pinned "
                         "submodule, which is what CI must use. Override while "
                         "drafting against an unmerged library branch.")
    a = ap.parse_args()

    global LIB
    LIB = (pathlib.Path(a.library) if a.library else ROOT/"library") / "records"
    if not LIB.is_dir():
        print("build-references: no records under %s" % LIB, file=sys.stderr); return 2

    report = pathlib.Path(a.report)
    text = report.read_text()
    body = text.split("REFERENCES:BEGIN", 1)[0]
    cited = sorted(set(re.findall(r'\[@([a-z0-9][a-z0-9._-]*)', body)))
    recs = load()

    missing = [c for c in cited if c not in recs]
    if missing:
        print("build-references: %d citation(s) with no library record:" % len(missing),
              file=sys.stderr)
        for m in missing: print("  [@%s]" % m, file=sys.stderr)
        print("\nIngest them (library/bin/ingest) or remove the citation.", file=sys.stderr)
        return 1

    lines = ["<!-- REFERENCES:BEGIN -->",
             "<!-- generated by bin/build-references — do not edit by hand -->",
             ""]
    for c in cited:
        r = recs[c]
        t = r["title"] or c
        u = r["url"]
        entry = "- **[%s]** %s" % (c, t)
        if u: entry += "  \n  <%s>" % u
        lines.append(entry)
    lines += ["", "<!-- REFERENCES:END -->"]

    new = re.sub(r'<!-- REFERENCES:BEGIN -->.*?<!-- REFERENCES:END -->',
                 "\n".join(lines), text, flags=re.S)
    report.write_text(new)
    print("build-references: %d citations, all resolved" % len(cited))
    return 0

sys.exit(main())
