#!/usr/bin/env bash
# build-site — assemble docs/ from the authored artifacts, then build.
# artifacts/docs/ is the source of truth; docs/ is a staging area.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Same pinned toolchain as CI and deploy. Warn rather than fail: a contributor
# reading the site locally should not be forced into a version bump.
if command -v python3 >/dev/null && [ -f requirements-docs.txt ]; then
  want=$(grep -m1 '^mkdocs-material==' requirements-docs.txt | cut -d= -f3)
  have=$(python3 -m pip show mkdocs-material 2>/dev/null | awk '/^Version:/{print $2}')
  if [ -n "$have" ] && [ "$want" != "$have" ]; then
    echo "warn: mkdocs-material $have installed, requirements-docs.txt pins $want" >&2
    echo "warn: CI will build with $want - run: pip install -r requirements-docs.txt" >&2
  fi
fi
bin/manifest                      # regenerate nav + manifest first
mkdir -p docs/architecture docs/project docs/research docs/library
cp spec/*.md docs/architecture/
cp project/*.md docs/project/
[ -n "$(ls research/*.md 2>/dev/null)" ] && cp research/*.md docs/research/ || true
# The library's index/ and exports/ are generated and untracked, so the pinned
# submodule checkout does not contain them - build them from the pinned records
# before copying. These used to be copied behind `[ -f ]` guards, which would
# now skip silently and publish a site with no bibliography at all.
( cd library && bin/export >/dev/null && bin/reindex >/dev/null )
for f in library/index/bibliography.md library/exports/references.json; do
  [ -f "$f" ] || { echo "build-site: $f missing after generation - library pin may predate the generated-views change"; exit 1; }
done
cp library/index/bibliography.md docs/library/
cp library/exports/references.json docs/library/
cp LIMITATIONS.md docs/
[ -f library/docs/construction.md ] && cp library/docs/construction.md docs/library/
mkdocs build --strict
