#!/usr/bin/env python3
"""mofn — the wallet engine's command line. The commands are in cli.py.

This file only finds the engine and says, in one line, what to install when
PyNaCl or PyYAML is missing.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

PACKAGES = {"nacl": "PyNaCl", "yaml": "PyYAML"}

try:
    import cli
except ModuleNotFoundError as e:
    top = (e.name or "").split(".")[0]
    if top not in PACKAGES:
        raise
    print(
        f"mofn: this Python cannot import {top} ({PACKAGES[top]}); install the "
        f"requirements: {sys.executable} -m pip install -r "
        f"{os.path.join(HERE, 'requirements.txt')}",
        file=sys.stderr,
    )
    sys.exit(2)

if __name__ == "__main__":
    sys.exit(cli.main())
