<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the signed desktop wallet (release.yml).
     A PyInstaller app loads a bundled Python and Qt, and PyNaCl's cffi makes
     closures at run time, so the hardened runtime needs these two. Nothing
     else is asked for: no sandbox, no network, no camera, no microphone. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
